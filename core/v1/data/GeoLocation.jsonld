{
  "@context": {
    "spdci": "https://schema.spdci.org/core/v1/data",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "spdci:GeoLocation",
      "@type": "rdfs:Class",
      "rdfs:label": "Geo Location",
      "rdfs:subClassOf": [
        {
          "@type": "rdfs:Class",
          "rdfs:label": "Structured Entity"
        }
      ],
      "rdfs:property": [
        {
          "@id": "spdci:latitude",
          "@type": "rdfs:Datatype",
          "rdfs:domain": "spdci:GeoLocation",
          "rdfs:range": "xsd:decimal",
          "rdfs:comment": "Latitude of a location, for example, 37.42242 (WGS 84)"
        },
        {
          "@id": "spdci:longitude",
          "@type": "rdfs:Datatype",
          "rdfs:domain": "spdci:GeoLocation",
          "rdfs:range": "xsd:decimal",
          "rdfs:comment": "Longitude of a location, for example, -122.08585 (WGS 84)"
        },
        {
          "@id": "spdci:altitude",
          "@type": "rdfs:Datatype",
          "rdfs:domain": "spdci:GeoLocation",
          "rdfs:range": "xsd:decimal",
          "rdfs:comment": "Altitude of a location, for example, 500.42212 (WGS 84)"
        },
        {
          "@id": "spdci:plus_code",
          "@type": "rdfs:Datatype",
          "rdfs:domain": "spdci:GeoLocation",
          "rdfs:range": "spdci:GooglePlusCode",
          "rdfs:comment": "Plus code information for the location"
        }
      ]
    }
  ]
}
