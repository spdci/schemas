{
    "@context": {
      "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
      "@vocab": "http://schema.spdci.org/extensions/ews/v1/code",
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "schema": "http://schema.org/"
    },
    "@graph": [
      {
        "@id": "type:AlertSeverity",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": "rdfs:Resource",
        "rdfs:label": "Alert Severity",
        "rdfs:comment": "Indicates how serious the hazard is, based on CAP standards",
        "owl:oneOf": [
          "code:extreme",
          "code:severe",
          "code:moderate",
          "code:minor",
          "code:unknown"
        ]
      },
      {
        "@id": "code:extreme",
        "@type": "type:AlertSeverity",
        "rdfs:label": "Extreme",
        "rdfs:comment": "Extraordinary threat"
      },
      {
        "@id": "code:severe",
        "@type": "type:AlertSeverity",
        "rdfs:label": "Severe",
        "rdfs:comment": "Significant threat"
      },
      {
        "@id": "code:moderate",
        "@type": "type:AlertSeverity",
        "rdfs:label": "Moderate",
        "rdfs:comment": "Moderate threat"
      },
      {
        "@id": "code:minor",
        "@type": "type:AlertSeverity",
        "rdfs:label": "Minor",
        "rdfs:comment": "Minor threat"
      },
      {
        "@id": "code:unknown",
        "@type": "type:AlertSeverity",
        "rdfs:label": "Unknown",
        "rdfs:comment": "Severity not yet determined"
      }
      
    ]
  }
  