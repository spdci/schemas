{
    "@context": {
      "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
      "@vocab": "http://schema.spdci.org/extensions/ews/v1/code",
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "schema": "http://schema.org/"
    },
    "@graph": [
      {
        "@id": "type:Certainty",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": "rdfs:Resource",
        "rdfs:label": "Alert Severity",
        "rdfs:comment": "Indicates how serious the hazard is, based on CAP standards",
        "owl:oneOf": [
          "code:observed",
          "code:likely",
          "code:possible",
          "code:unlikely",
          "code:unknown"
        ]
      },
      {
        "@id": "code:observed",
        "@type": "type:Certainty",
        "rdfs:label": "Observed",
        "rdfs:comment": "Event has been observed or verified"
      },
      {
        "@id": "code:likely",
        "@type": "type:Certainty",
        "rdfs:label": "Likely",
        "rdfs:comment": "Event is expected to occure with high probability"
      },
      {
        "@id": "code:possible",
        "@type": "type:Certainty",
        "rdfs:label": "Possible",
        "rdfs:comment": "Event may occur, probability is uncertain"
      },
      {
        "@id": "code:unlikely",
        "@type": "type:Certainty",
        "rdfs:label": "Unlikely",
        "rdfs:comment": "Event is not expected to occur; probability is low"
      },
      {
        "@id": "code:unknown",
        "@type": "type:Certainty",
        "rdfs:label": "Unknown",
        "rdfs:comment": "Likelihood is unknown"
      }
      
    ]
  }
  