{
    "@context": {
      "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
      "@vocab": "http://schema.spdci.org/extensions/ews/v1/code",
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "schema": "http://schema.org/"
    },
    "@graph": [
      {
        "@id": "type:Scope",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": "rdfs:Resource",
        "rdfs:label": "Scope",
        "rdfs:comment": "Specifies the intended distribution and visibility of the alert",
        "owl:oneOf": [
          "code:public",
          "code:restricted",
          "code:private"
        ]
      },
      {
        "@id": "code:public",
        "@type": "type:Scope",
        "rdfs:label": "Public",
        "rdfs:comment": "Alert intended for general public dissemination"
      },
      {
        "@id": "code:restricted",
        "@type": "type:Scope",
        "rdfs:label": "Restricted",
        "rdfs:comment": "Alert intended for restricted audience (e.g government agencies)"
      },
      {
        "@id": "code:private",
        "@type": "type:Scope",
        "rdfs:label": "Private",
        "rdfs:comment": "Alert intended for specific individuals or private distribution"
      }
      
    ]
  }
  