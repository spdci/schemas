{
    "@context": {
      "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
      "@vocab": "http://schema.spdci.org/extensions/ews/v1/code",
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "schema": "http://schema.org/"
    },
    "@graph": [
      {
        "@id": "type:status",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": "rdfs:Resource",
        "rdfs:label": "Status",
        "rdfs:comment": "Specifies the current operational status of the alert message",
        "owl:oneOf": [
          "code:actual",
          "code:exercise",
          "code:system",
          "code:test",
          "code:draft"
        ]
      },
      {
        "@id": "code:actual",
        "@type": "type:status",
        "rdfs:label": "Actual",
        "rdfs:comment": "The alert message pertains to a real-world event"
      },
      {
        "@id": "code:exercise",
        "@type": "type:status",
        "rdfs:label": "Exercise",
        "rdfs:comment": "The alert is part of a drill or test exercise"
      },
      {
        "@id": "code:system",
        "@type": "type:status",
        "rdfs:label": "System",
        "rdfs:comment": "The alert was generated by an automated system"
      },
      {
        "@id": "code:test",
        "@type": "type:status",
        "rdfs:label": "Test",
        "rdfs:comment": "The alert is a system test and not for operational use."
      },
      {
        "@id": "code:draft",
        "@type": "type:status",
        "rdfs:label": "Draft",
        "rdfs:comment": "The alert is a draft and not yet released for dissemination."
      }
      
    ]
  }
  