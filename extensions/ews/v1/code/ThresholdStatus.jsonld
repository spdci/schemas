{
    "@context": {
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "@vocab": "http://schema.spdci.org/extensions/ews/v1/code",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "schema": "http://schema.org/"
    },
    "@graph": [
        {
            "@id": "type:ThresholdStatus",
            "@type": "rdfs:Class",
            "rdfs:subClassOf": "rdfs:Resource",
            "rdfs:label": "Threshold Status",
            "rdfs:comment": "Tracks step-by-step escalations of the environmental indicators",
            "owl:oneOf": [
                "code:NORMAL",
                "code:WATCH",
                "code:CROSSING_THRESHOLD_1",
                "code:TRIGGER"
            ]
        },
        {
            "@id": "code:NORMAL",
            "@type": "type:ThresholdStatus",
            "rdfs:label": "Normal",
            "rdfs:comment": "Indicators are within normal range"
        },
        {
            "@id": "code:WATCH",
            "@type": "type:ThresholdStatus",
            "rdfs:label": "Watch",
            "rdfs:comment": "Indicators are being watched for possible escalation"
        },
        {
            "@id": "code:CROSSING_THRESHOLD_1",
            "@type": "type:ThresholdStatus",
            "rdfs:label": "Crossing Threshold 1",
            "rdfs:comment": "Indicators have crossed the first threshold"
        },
        {
            "@id": "code:TRIGGER",
            "@type": "type:ThresholdStatus",
            "rdfs:label": "Trigger",
            "rdfs:comment": "Indicators have reached the trigger level for anticipatory action"
        }
    ]
}
