{
    "@context": {
      "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
      "@vocab": "http://schema.spdci.org/extensions/ews/v1/code",
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "schema": "http://schema.org/"
    },
    "@graph": [
      {
        "@id": "type:urgency",
        "@type": "rdfs:Class",
        "rdfs:subClassOf": "rdfs:Resource",
        "rdfs:label": "Urgency",
        "rdfs:comment": "Specifies how quickly the recipient should act on the alert",
        "owl:oneOf": [
          "code:immediate",
          "code:expected",
          "code:future",
          "code:past",
          "code:unknown"
        ]
      },
      {
        "@id": "code:immediate",
        "@type": "type:urgency",
        "rdfs:label": "Immediate",
        "rdfs:comment": "Action should be taken immediately"
      },
      {
        "@id": "code:expected",
        "@type": "type:urgency",
        "rdfs:label": "Expected",
        "rdfs:comment": "Action should be taken soon, within a defined time window"
      },
      {
        "@id": "code:future",
        "@type": "type:urgency",
        "rdfs:label": "Future",
        "rdfs:comment": "Action is required in the future; event is not imminent"
      },
      {
        "@id": "code:past",
        "@type": "type:urgency",
        "rdfs:label": "Past",
        "rdfs:comment": "The event has already occurred; alert may provide historical or warning info"
      },
      {
        "@id": "code:unknown",
        "@type": "type:urgency",
        "rdfs:label": "Unknown",
        "rdfs:comment": "Urgency is unknown or not specified"
      }
      
    ]
  }
  