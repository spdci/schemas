{
    "@context": {
        "spdci": "https://schema.spdci.org/extensions/ews/v1/data",
        "code": "https://schema.spdci.org/extensions/ews/v1/code",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "spdcicore": "https://schema.spdci.org/core/v1/data",
        "spdcicode": "https://schema.spdci.org/core/v1/code",
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "owl": "http://www.w3.org/2002/07/owl#"
    },
    "@id": "spdci:Alert",
    "@type": "rdfs:Class",
    "rdfs:comment": "The Geojson feature object in accordance with OGC API features standard",
    "rdfs:label": "Alert",
    "rdfs:subClassOf": [
      {
        "@type": "rdfs:Class",
        "rdfs:label": "Structured Entity"
      }
    ],
    "rdfs:property": [
          {
            "@id": "spdci:id",
            "@type": "rdfs:Datatype",
            "rdfs:domain": "spdci:Alert",
            "rdfs:range": "xsd:string",
            "rdfs:comment": "Unique identifier of the alert feature."
           },
          {
            "@id": "spdci:type",
            "@type": "rdfs:Datatype",
            "rdfs:domain": "spdci:Alert",
            "rdfs:range": "xsd:string",
            "rdfs:comment": "Shall be set to Feature as defined by the GeoJSON specification"
          },
          {
            "@id": "spdci:geometry",
            "@type": "rdfs:Datatype",
            "rdfs:domain": "spdci:Alert",
            "rdfs:range": "spdcicore:GeoShape",
            "rdfs:comment": "GeoJson geometry object representing the spatial extent of the hazad"
          },
          {
            "@id": "spdci:properties",
            "@type": "rdfs:Datatype",
            "rdfs:domain": "spdci:Alert",
            "rdfs:range":  {
                "@type": "@id",
                "@container": "@list"
            },
            "rdfs:comment": "Container for non-spatial alert information aligned with CAP semantics",
            "schema:value": {
                "@type": "spdci:CapAlert"
            }
          }
          
    ]
    }