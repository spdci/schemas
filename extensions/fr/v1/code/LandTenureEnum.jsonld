{
    "@context": {
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "@vocab": "http://schema.spdci.org/extensions/fr/v1/code",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "schema": "http://schema.org/"
    },
    "@graph": [
        {
            "@id": "type:LandTenureEnum",
            "@type": "rdfs:Class",
            "rdfs:subClassOf": "rdfs:Resource",
            "rdfs:label": "Land Tenure Enum",
            "rdfs:comment": "This directory references land access to land options, as outlined in Section 3.25 of the FAO Land Tenure Studies.",
            "owl:oneOf": [
                "type:1",
                "type:2",
                "type:3",
                "type:4",
                "type:5",
                "type:6",
                "type:7"
            ]
        },
        {
            "@id": "type:1",
            "@type": "type:LandTenureEnum",
            "rdfs:label": "Owner",
            "rdfs:comment": "Owner of the land"
        },
        {
            "@id": "type:2",
            "@type": "type:LandTenureEnum",
            "rdfs:label": "Non-legal ownership/Squatting illegally on land",
            "rdfs:comment": "Non-legal ownership/Squatting illegally on land"
        },
        {
            "@id": "type:3",
            "@type": "type:LandTenureEnum",
            "rdfs:label": "Leased (Rented from someone else)",
            "rdfs:comment": "Leased (Rented from someone else)"
        },
        {
            "@id": "type:4",
            "@type": "type:LandTenureEnum",
            "rdfs:label": "Adverse possession or prescription",
            "rdfs:comment": "Adverse possession or prescription (the acquisition of rights through possession for a prescribed period of time)"
        },
        {
            "@id": "type:5",
            "@type": "type:LandTenureEnum",
            "rdfs:label": "Sharecropping",
            "rdfs:comment": "Sharecropping"
        },
        {
            "@id": "type:6",
            "@type": "type:LandTenureEnum",
            "rdfs:label": "Inheritance",
            "rdfs:comment": "Inheritance (gaining access to land as an heir)"
        },
        {
            "@id": "type:7",
            "@type": "type:LandTenureEnum",
            "rdfs:label": "Holdings without land",
            "rdfs:comment": "Holdings without land"
        }
    ]
}
