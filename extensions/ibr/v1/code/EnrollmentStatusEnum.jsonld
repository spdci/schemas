{
    "@context": {
        "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
        "@vocab": "http://schema.spdci.org/extensions/ibr/v1/code",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "schema": "http://schema.org/"
    },
    "@graph": [
        {
            "@id": "benefit:EnrollmentStatusEnum",
            "@type": "rdfs:Class",
            "rdfs:subClassOf": "rdfs:Resource",
            "rdfs:label": "Beneficiary Status Enum",
            "rdfs:comment": "Enumeration for the status of beneficiaries with a specific program.",
            "owl:oneOf": [
                "benefit:1",
                "benefit:2",
                "benefit:3",
                "benefit:4",
                "benefit:5",
                "benefit:6",
                "benefit:7"
            ]
        },
        {
            "@id": "benefit:1",
            "@type": "benefit:EnrollmentStatusEnum",
            "rdfs:label": "Active",
            "rdfs:comment": "Standardized code for an active beneficiary."
        },
        {
            "@id": "benefit:2",
            "@type": "benefit:EnrollmentStatusEnum",
            "rdfs:label": "Deceased",
            "rdfs:comment": "Standardized code for a deceased beneficiary."
        },
        {
            "@id": "benefit:3",
            "@type": "benefit:EnrollmentStatusEnum",
            "rdfs:label": "Graduated",
            "rdfs:comment": "Standardized code for a graduated beneficiary."
        },
        {
            "@id": "benefit:4",
            "@type": "benefit:EnrollmentStatusEnum",
            "rdfs:label": "Suspended",
            "rdfs:comment": "Standardized code for a suspended beneficiary."
        },
        {
            "@id": "benefit:5",
            "@type": "benefit:EnrollmentStatusEnum",
            "rdfs:label": "Inactive",
            "rdfs:comment": "The beneficiary is temporarily not receiving benefits, but has not been formally suspended or exited the programme. This could be due to administrative issues, temporary ineligibility, or the beneficiary's personal request."
        },
        {
            "@id": "benefit:6",
            "@type": "benefit:EnrollmentStatusEnum",
            "rdfs:label": "Reinstated",
            "rdfs:comment": "The beneficiary was previously suspended or exited, but has been reinstated in the programme, typically after meeting certain conditions or upon resolution of the issues that led to their suspension or exit."
        },
        {
            "@id": "benefit:7",
            "@type": "benefit:EnrollmentStatusEnum",
            "rdfs:label": "Awaiting Renewal",
            "rdfs:comment": "The beneficiary's enrolment period is nearing its end, and they are in the process of renewal, subject to reassessment and continued eligibility."
        }
    ]
}
