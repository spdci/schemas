{
  "@context": {
    "spdci": "https://schema.spdci.org/extensions/id/v1/data",
    "code": "https://schema.spdci.org/extensions/id/v1/code",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#"
  },
  "@id": "spdci:Biometric_Data",
  "@type": "rdfs:Class",
  "rdfs:comment": "This data object contains the demographic information about a biometric data to verify against data in the id system.",
  "rdfs:label": "ID Person",
  "rdfs:property": [
    {
      "@id": "spdci:data",        
      "@type": "rdf:Property",
      "rdfs:domain": "spdci:Biometric_Data",   
      "rdfs:range": "xsd:base64Binary",     
      "rdfs:comment": "The biometric data."
    },
    {
      "@id": "spdci:type",        
      "@type": "rdf:Property",
      "rdfs:domain": "spdci:Biometric_Data",   
      "rdfs:range": "code:TypeEnum",     
      "rdfs:comment": "The type of biometric."
    },
    {
      "@id": "spdci:issuer",        
      "@type": "rdf:Property",
      "rdfs:domain": "spdci:Biometric_Data",   
      "rdfs:range": "xsd:string",     
      "rdfs:comment": "the identity of the sender of this data."
    },
    {
        "@id": "spdci:data_type",
        "@type": "rdf:Property",
        "rdfs:domain": "spdci:Biometric_Data",
        "rdfs:range": "code:DataTypeEnum",
        "rdfs:comment": "The data type of the biometric data."
    }
  ]
}
